# Sin nada configurado: usa pollinations (IA remota, sin key, sin modelo local).
# Si pollinations falla o quieres modo offline total: AI_PROVIDER=heuristic.
# Con servidor propio: OLLAMA_URL (+ OLLAMA_MODEL), sin API key.
# Con Google: GEMINI_API_KEY (opcional, usa cuota de Google).

PORT=3000

# auto = gemini si hay key, ollama si hay URL, si no pollinations.
# Forzar: AI_PROVIDER=pollinations | ollama | gemini | heuristic
AI_PROVIDER=auto
POLLINATIONS_MODEL=openai

# Tu servidor de modelos (local o remoto, sin autenticación).
# Ejemplos: http://localhost:11434  |  https://tu-servidor
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:7b

# Proveedor comercial opcional.
GEMINI_API_KEY=

# MongoDB opcional. Sin esto usa server/dataset/*.json
MONGODB_URI=mongodb://localhost:27017/pair
