# ╔══════════════════════════════════════════════════════════════╗
# ║  NEON/NULL — User Configuration                             ║
# ║  "Customize the signal. Own the frequency."                 ║
# ║                                                             ║
# ║  This file is sourced by neon.sh on startup.               ║
# ║  Copy to ~/.neon/config and edit to taste.                 ║
# ║  All values shown are defaults.                             ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Active Theme ──────────────────────────────────────────────
# Available: default, cyber-night, void
# Create your own: ~/.neon/themes/my-theme.theme
NEON_ACTIVE_THEME="default"

# ── Colors ────────────────────────────────────────────────────
# Hex color values (24-bit truecolor, requires compatible terminal)
# Primary: main UI elements (prompt arrow, borders, indicators)
NEON_PRIMARY="#ff003c"
# Secondary: supporting elements (user badge, accents)
NEON_SECONDARY="#ff2d6b"
# Accent: highlights, links, special indicators
NEON_ACCENT="#00f0ff"

# ── Effects ───────────────────────────────────────────────────
# Glitch intensity: 0.01 (barely visible static) to 0.5 (full chaos)
# Recommended: 0.03-0.08 for daily use, 0.2+ for demos/screenshots
# "The right amount of corruption reveals the truth hidden in clean data"
NEON_GLITCH_INTENSITY=0.05

# Matrix rain — falls during AI processing sessions
NEON_ENABLE_RAIN=true

# CRT scanlines — subtle horizontal line overlay
NEON_ENABLE_SCANLINES=true

# Terminal border — draws frame around terminal viewport
NEON_ENABLE_BORDER=true

# Typewriter sound effects (requires Node.js companion: npm i -g neon-terminal)
NEON_ENABLE_SOUND=false

# Text glow — adds subtle luminance to neon-colored text
NEON_ENABLE_GLOW=true

# ── Rain Configuration ────────────────────────────────────────
# Speed: milliseconds between animation frames (lower = faster)
# Range: 20 (blazing) to 200 (meditative)
NEON_RAIN_SPEED=50

# Density: number of rain columns visible at once
# Range: 5 (sparse) to 40 (heavy downpour)
NEON_RAIN_DENSITY=15

# Color: red, green, cyan
# green = classic matrix, red = NEON/NULL signature, cyan = ice
NEON_RAIN_COLOR="red"

# ── Border Configuration ──────────────────────────────────────
# Styles: single, double, rounded, glow
# single  = thin lines (┌─┐)
# double  = thick lines (╔═╗) — NEON/NULL standard
# rounded = curved corners (╭─╮)
# glow    = color-cycling animated border
NEON_BORDER_STYLE="double"

# ── Prompt Configuration ──────────────────────────────────────
# Timestamp format (strftime)
# "%H:%M:%S" = 24h with seconds
# "%H:%M"    = 24h, no seconds
# "%I:%M %p" = 12h with AM/PM
NEON_TIMESTAMP_FMT="%H:%M:%S"

# ── AI Detection ──────────────────────────────────────────────
# Show ◈ AI indicator in prompt when AI CLI is running
NEON_AI_INDICATOR=true

# Track and display AI session duration on exit
NEON_SESSION_TRACKER=true

# ── Post-Command Hook ────────────────────────────────────────
# Minimum command duration (seconds) to show timing
# Set to 0 to always show, 1+ to only show for slow commands
NEON_POSTCMD_MIN_TIME=1

# Always show exit code (true) or only on error (false)
NEON_POSTCMD_EXIT_ALWAYS=false

# Apply glitch effect on command errors
NEON_POSTCMD_GLITCH_ERROR=true

# ── Scanline Configuration ────────────────────────────────────
# Density: 1 = strong (every other line), 2 = subtle, 3 = very subtle
NEON_SCANLINE_DENSITY=2

# ── Advanced / Lore ───────────────────────────────────────────
# "The NEON/NULL collective operates on principle 7:
#  All signals are shared. All terminals are connected.
#  The boundary between user and network is an illusion."
#
# These settings are for NEON/NULL operatives only.
# Standard users should leave defaults unchanged.

# Enable verbose debug logging to ~/.neon/debug.log
NEON_DEBUG=false

# Custom AI commands to detect (space-separated)
# NEON_CUSTOM_AI_COMMANDS="my-ai-tool another-tool"

# Network status display (cosmetic — shows in prompt)
# This is the NEON/NULL relay status indicator
NEON_SHOW_NETWORK_STATUS=true
