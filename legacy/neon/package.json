{
  "name": "neon-terminal",
  "version": "1.0.0",
  "description": "Cyberpunk terminal skin for AI coding CLIs — CRT scanlines, matrix rain, glitch effects, neon glow",
  "keywords": [
    "terminal",
    "cyberpunk",
    "ai",
    "cli",
    "claude-code",
    "aider",
    "codex",
