    "skin",
    "matrix",
    "glitch",
    "neon",
    "crt",
    "scanlines"
  ],
  "homepage": "https://github.com/neon-null/neon",
  "bugs": {
    "url": "https://github.com/neon-null/neon/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/neon-null/neon.git"
  },
  "license": "MIT",
  "author": "NEON/NULL Collective",
  "type": "module",
  "bin": {
    "neon": "./bin/neon"
  },
  "files": [
    "bin/",
    "neon.sh",
    "install.sh",
    "themes/",
    "ascii/",
    "effects/",
    "hooks/",
    "config/"
  ],
  "scripts": {
    "install": "bash install.sh",
    "test": "bash -n neon.sh && echo '✓ syntax ok'",
