# ========================
# DATABASE
# ========================
DATABASE_URL=postgresql://user:password@localhost:5432/natalia_db

# ========================
# SUPABASE
# ========================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ========================
# CLAUDE API (Anthropic)
# ========================
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# ========================
# ELEVENLABS (Voice)
# ========================
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Default female voice

# ========================
# STRIPE (Payments)
# ========================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ========================
# NEXTAUTH (Authentication)
# ========================
NEXTAUTH_SECRET=your_nextauth_secret_generated_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# ========================
# OAUTH PROVIDERS (Optional)
# ========================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ========================
# SMTP (Email)
# ========================
SENDGRID_API_KEY=your_sendgrid_api_key
SMTP_FROM_EMAIL=noreply@natalia.app

# ========================
# AWS S3 (Optional backup)
# ========================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=natalia-wardrobe-backups

# ========================
# ENVIRONMENT
# ========================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ========================
# FEATURE FLAGS
# ========================
ENABLE_VOICE_BETA=true
ENABLE_SOCIAL_SHARING=false
ENABLE_AR_TRYON=false
ENABLE_ANALYTICS=true

# ========================
# LOGGING & DEBUGGING
# ========================
DEBUG=natalia:*
LOG_LEVEL=info
